# PostgreSQL (replace every placeholder in production)
POSTGRES_DB=eraasim
POSTGRES_USER=eraasim_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Admin database connection. Inside Compose, the hostname is eraasim-postgres.
DATABASE_URL=postgresql://eraasim_app:replace-with-a-long-random-password@eraasim-postgres:5432/eraasim

# Generate a strong random value; never reuse the database password.
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Master Admin bootstrap identity. Remove/unset the password after bootstrap.
MASTER_ADMIN_EMAIL=unveiledjourney.asim@gmail.com
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_BOOTSTRAP_PASSWORD=

# Optional at build time; required at runtime for Gmail Contact notifications.
# Use a dedicated Google App Password. Never use the account's normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-account@example.com
SMTP_APP_PASSWORD=replace-with-deployment-only-google-app-password
CONTACT_EMAIL_FROM="Eraasim <your-gmail-account@example.com>"
PUBLIC_SITE_URL=https://your-public-eraasim-domain.example
SUBSCRIBER_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
