# PostgreSQL (replace every placeholder in production)
POSTGRES_DB=eraasim
POSTGRES_USER=eraasim_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Admin database connection. Inside Compose, the hostname is eraasim-postgres.
DATABASE_URL=postgresql://eraasim_app:replace-with-a-long-random-password@eraasim-postgres:5432/eraasim

# Generate a strong random value; never reuse the database password.
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Master Admin bootstrap identity. Remove/unset the password after bootstrap.
MASTER_ADMIN_EMAIL=unveiledjourney.asim@gmail.com
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_BOOTSTRAP_PASSWORD=

# Optional Contact Us notification adapter. Enquiries are always stored first.
# The URL must be HTTPS and accept JSON with a Bearer token.
CONTACT_EMAIL_WEBHOOK_URL=
CONTACT_EMAIL_WEBHOOK_TOKEN=
